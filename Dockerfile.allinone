# 单容器部署版 Dockerfile
FROM golang:1.23-alpine AS builder

WORKDIR /build

# 安装必要的构建工具
RUN apk add --no-cache git

# 复制 go mod 文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 编译所有服务
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/gateway ./services/gateway
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/user-rpc ./services/user/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/counter-rpc ./services/counter/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/knowpost-rpc ./services/knowpost/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/relation-rpc ./services/relation/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/search-rpc ./services/search/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/storage-rpc ./services/storage/rpc
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bin/llm-rpc ./services/llm/rpc

# 运行阶段 - 包含所有依赖
FROM alpine:latest

# 安装所有依赖服务
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    bash \
    supervisor \
    mysql \
    mysql-client \
    redis \
    etcd \
    openjdk11-jre-headless

# 设置时区
ENV TZ=Asia/Shanghai

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /build/bin/ ./bin/

# 复制配置文件
COPY services/ ./services/
COPY certs/ ./certs/
COPY db/ ./db/

# 创建数据目录
RUN mkdir -p /var/lib/mysql /var/lib/redis /var/lib/etcd /var/log/supervisor

# 复制 supervisord 配置
COPY deploy/docker/supervisord.conf /etc/supervisord.conf

# 复制启动脚本
COPY deploy/docker/start-all.sh /app/start-all.sh
RUN chmod +x /app/start-all.sh

# 暴露端口
EXPOSE 8080 9002 9003 9004 9006 9013 9017 9018 2379 3306 6379

# 启动脚本
CMD ["/app/start-all.sh"]
